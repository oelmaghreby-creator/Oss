# Copy to .env and adjust as needed.
OLLAMA_IMAGE_TAG=latest
OPEN_WEBUI_IMAGE_TAG=main
OLLAMA_PORT=11434
WEBUI_PORT=3000
# Space-separated list used by `make pull`
OLLAMA_MODELS="qwen3:8b qwen3:30b-a3b nomic-embed-text"
# VPS only (`make up VPS=1`): domain for automatic HTTPS. Leave unset for plain HTTP on port 80.
# DOMAIN=chat.example.com
